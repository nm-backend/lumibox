# Шаблон переменных окружения для боевого сервера.
# Скопировать в .env (или задать в панели хостинга), заполнить значения.
# Файл .env в git не попадает — секреты в репозитории не хранятся.

# --- Обязательные ---

# Длинный случайный ключ. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Домены через запятую. Домен *.onrender.com приложение добавит само.
DJANGO_ALLOWED_HOSTS=lumibox.example.com

DJANGO_DEBUG=False

# База и кэш. На PaaS эти URL выдаёт платформа — подставляются автоматически.
DATABASE_URL=postgres://user:password@host:5432/lumibox
REDIS_URL=redis://host:6379/0

# Перед Django стоит один прокси (Nginx/балансировщик платформы).
DJANGO_NUM_PROXIES=1

# --- Первый администратор (создаётся при первом старте, если заданы обе) ---
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=

# --- Почта (обязательно для сброса пароля) ---
# Если EMAIL_HOST пуст — письма печатаются в консоль, отправки нет.
# Бесплатные варианты: Mailgun (1 000 писем/мес), SendGrid, Gmail SMTP.
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LumiBox <noreply@lumibox.app>

# --- Cloudflare R2 (обязательно для постоянного хранения медиа) ---
# Без R2 загруженные постеры и видео живут на диске сервера и теряются
# при пересоздании контейнера (эфемерная ФС Render). Секрет-ключ R2 —
# в Dashboard Cloudflare → R2 → Manage R2 API Tokens.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
# Публичный URL бакета (R2.dev или свой домен) — постеры/видео отдаются им напрямую.
CLOUDFLARE_R2_PUBLIC_URL=

# --- Мониторинг (опционально) ---
# Sentry: бесплатный tier 5 000 событий/мес. Если пусто — не инициализируется.
SENTRY_DSN=

# --- Аналитика (опционально) ---
# GA4: если пусто — трекинг не вставляется в шаблон.
GA_MEASUREMENT_ID=

# --- Только для docker-compose.prod.yml (свой сервер) ---
# Эти значения собирают DATABASE_URL для контейнера базы.
POSTGRES_DB=lumibox
POSTGRES_USER=lumibox
POSTGRES_PASSWORD=
