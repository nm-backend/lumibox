# Образец переменных окружения.
# Скопируй этот файл в .env и подставь свои значения.
# Сам .env в git не попадает — в нём настоящие пароли.

# Сгенерировать новый ключ:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=замени-на-свой-ключ

DJANGO_DEBUG=True

# Список доменов через запятую. Локально не используется.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Строка подключения к базе: postgres://пользователь:пароль@хост:порт/имя_базы
# Порт 5433 — это база в Docker. Для локально установленного PostgreSQL — 5432.
DATABASE_URL=postgres://lumibox:пароль@localhost:5433/lumibox

# Redis: кэш и брокер Celery. Необязателен — без него кэш работает
# в памяти процесса, а фоновые задачи выполняются прямо в запросе.
REDIS_URL=redis://localhost:6380/0

# Эти три переменные читает docker compose, когда поднимает контейнер базы.
POSTGRES_USER=lumibox
POSTGRES_PASSWORD=придумайте-пароль
POSTGRES_DB=lumibox


# Cloudflare R2 — S3-совместимое объектное хранилище для медиафайлов.
# Если не задать AWS_STORAGE_BUCKET_NAME — работает локальный диск.
# Без R2 файлы теряются при перезапуске на Render (эфимерная ФС).
#
# 1. Зарегистрироваться на https://cloudflare.com
# 2. Создать R2 bucket (например, lumibox-media)
# 3. Создать API-токен (Access Key → R2; Edit)
# 4. Получить ID аккаунта → endpoint: https://<accountid>.r2.cloudflarestorage.com
# 5. Включить публичный доступ: bucket → Settings → Public Access → Allow
#
# AWS_ACCESS_KEY_ID=примерно_20_символов
# AWS_SECRET_ACCESS_KEY=примерно_40_символов
# AWS_STORAGE_BUCKET_NAME=lumibox-media
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev  # необязательно, но быстрее
