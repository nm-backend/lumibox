# ─── LumiBox: пример конфигурации окружения ──────────────────────────────
# Скопируйте в .env и замените значения на свои.
#
#   cp .env.example .env
#
# DJANGO_SECRET_KEY и DATABASE_URL обязательны — без них проект не запустится.
# Остальные переменные опциональны.

# ─── Обязательные ─────────────────────────────────────────────────────────

# Секретный ключ Django. Сгенерируйте случайную строку:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Подключение к PostgreSQL.
# Формат: postgres://пользователь:пароль@хост:порт/имя_базы
# Локально: docker compose up -d db, затем:
DATABASE_URL=postgres://lumibox:postgres@localhost:5432/lumibox

# ─── Режим отладки ────────────────────────────────────────────────────────

# True — показывать подробные ошибки (только для локальной разработки).
# False — скрывать детали ошибок (продакшен).
DJANGO_DEBUG=True

# Разрешённые хосты (через запятую).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Redis / Celery (опционально) ─────────────────────────────────────────

# Без Redis проект работает на LocMemCache и Celery в режиме eager.
# С Redis — кэш между процессами и фоновые задачи по расписанию.
# Локально: docker compose up -d redis
REDIS_URL=redis://localhost:6379/0

# ─── Cloudflare R2 (опционально, для продакшена) ──────────────────────────

# Если настроить R2, медиафайлы хранятся в бакете и не теряются
# при перезапуске контейнера.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
CLOUDFLARE_R2_PUBLIC_URL=

# ─── Деплой (опционально) ─────────────────────────────────────────────────

# Render/Railway добавляют эту переменную автоматически.
# Позволяет сайту отвечать на *.onrender.com еще до привязки домена.
RENDER_EXTERNAL_HOSTNAME=

# Количество доверенных прокси (nginx, Cloudflare) перед Django.
# 0 — прокси нет; 1 — за nginx.
DJANGO_NUM_PROXIES=0

# ─── Суперпользователь для первого входа ──────────────────────────────────

# Если задать эти переменные, manage.py seed_catalog создаст
# администратора при первом запуске.
DJANGO_SUPERUSER_EMAIL=admin@lumibox.example
DJANGO_SUPERUSER_PASSWORD=admin123
