# Образец переменных окружения.
# Скопируй этот файл в .env и подставь свои значения.
# Сам .env в git не попадает — в нём настоящие пароли.

# Сгенерировать новый ключ:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=замени-на-свой-ключ

DJANGO_DEBUG=True

# Список доменов через запятую. Локально не используется.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Строка подключения к базе: postgres://пользователь:пароль@хост:порт/имя_базы
# Порт 5433 — это база в Docker. Для локально установленного PostgreSQL — 5432.
DATABASE_URL=postgres://moviehub:пароль@localhost:5433/moviehub

# Redis: кэш и брокер Celery. Необязателен — без него кэш работает
# в памяти процесса, а фоновые задачи выполняются прямо в запросе.
REDIS_URL=redis://localhost:6380/0

# Эти три переменные читает docker compose, когда поднимает контейнер базы.
POSTGRES_USER=moviehub
POSTGRES_PASSWORD=придумайте-пароль
POSTGRES_DB=moviehub

# Аналитика (необязательно)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# YANDEX_METRIKA_ID=12345678

# Sentry мониторинг (необязательно)
# SENTRY_DSN=https://xxx@sentry.io/xxx
