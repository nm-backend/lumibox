# Пример переменных окружения LumiBox.
#
# Скопируйте в .env и заполните. Сам .env в git не попадает (.gitignore),
# и настоящих значений здесь быть не должно — только пустые места.
#
# Одного файла достаточно и для разработки, и для боя: различие задаёт
# DJANGO_SETTINGS_MODULE, а не отдельный набор примеров.


# ─── Обязательное ────────────────────────────────────────────────────

# config.settings.development — локально, config.settings.production — в бою.
DJANGO_SETTINGS_MODULE=config.settings.development

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Без него проект не запустится — и это намеренно.
DJANGO_SECRET_KEY=

# Через запятую, без протокола: lumibox.com,www.lumibox.com
# CSRF_TRUSTED_ORIGINS соберётся из этого списка сам.
DJANGO_ALLOWED_HOSTS=

# postgres://пользователь:пароль@хост:порт/база
DATABASE_URL=

# Отладка. В бою всегда пусто или False.
DJANGO_DEBUG=


# ─── Кэш и фоновые задачи ────────────────────────────────────────────

# redis://хост:порт/0
# Пусто — кэш живёт в памяти процесса, а задачи выполняются прямо
# в запросе. Сайт поднимется, но без общего кэша между воркерами.
REDIS_URL=


# ─── Сеть ────────────────────────────────────────────────────────────

# Сколько доверенных прокси стоит перед приложением.
# 0 — прокси нет. За Render, Railway или своим Nginx ставьте 1.
# Значение важно: от него зависит, какой адрес считается адресом клиента
# при подсчёте лимитов запросов.
DJANGO_NUM_PROXIES=0

# Сколько секунд держать соединение с базой открытым между запросами.
# Пусто — 60. У управляемых баз есть предел живых соединений.
DJANGO_CONN_MAX_AGE=


# ─── Администратор ───────────────────────────────────────────────────

# Создаётся командой `python manage.py bootstrap_admin` при выкладке.
# Пароль задаёте вы — в репозитории его нет и быть не должно.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(18))"
#
# Повторная выкладка существующего администратора не трогает и пароль
# ему не меняет.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=


# ─── Хранилище медиа: Cloudflare R2 или любое S3-совместимое ──────────

#
# Пока не заполнено, файлы лежат на диске контейнера и пропадают при его
# пересоздании. Для боя с настоящим видео хранилище обязательно.
#
# Включается наличием имени бакета: если оно задано, остальные переменные
# этой группы становятся обязательными, и запуск с половиной заполненных
# остановится с понятной ошибкой.
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT_URL=
# Для R2 всегда auto; для S3 — регион бакета.
CLOUDFLARE_R2_REGION_NAME=auto
# Публичный адрес раздачи: домен R2.dev, свой поддомен или CDN перед ним.
CLOUDFLARE_R2_PUBLIC_URL=


# ─── Почта ───────────────────────────────────────────────────────────

#
# Пока EMAIL_HOST пуст, письма печатаются в лог, а не уходят —
# и сброс пароля работать не будет.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Адрес, с которого Django шлёт письма об ошибках администраторам.
# Если пуст, берётся DEFAULT_FROM_EMAIL.
SERVER_EMAIL=
# Задавать вручную нужно редко: при заданном EMAIL_HOST бэкенд SMTP
# включается сам. Переменная нужна, чтобы принудительно оставить
# печать писем в лог даже при настроенном SMTP.
EMAIL_BACKEND=


# ─── Необязательное ──────────────────────────────────────────────────

# Отслеживание ошибок. Пусто — Sentry не подключается.
SENTRY_DSN=

# Идентификатор Google Analytics. Пусто — на страницах нет ни байта
# аналитики; при заданном трекинг включается только после согласия.
GA_MEASUREMENT_ID=


# ─── Внешний видеосервис Vibix (плеер и синхронизация) ────────────────────

#
# Плеер встраивается на страницы записей тегом <ins> по ID видео,
# publisher_id выдаёт кабинет сервиса и привязывает к разрешённому домену.
# Example ID из документации использовать в production нельзя.
VIBIX_PUBLISHER_ID=678503345
# Токен доступа к API сервиса (Authorization: Bearer). Выдаётся
# в личном кабинете; команды sync_vibix / sync_voiceovers без него
# не запускаются, а планировщик пропускает задачу.
# Токен никогда не попадает в HTML, логи и git. НЕ вставляйте сюда
# реальное значение: заполните его в .env (не коммитится) или в
# секретах окружения сервера. Значение, попавшее когда-либо в git,
# считается скомпрометированным и подлежит ротации в кабинете Vibix.
VIBIX_API_TOKEN=
# Выделенный production API: /publisher/... живут под ним же,
# сериалы — напрямую (GET /api/v1/serials/...). Меняйте только если
# Vibix выдал вашему аккаунту другой официальный endpoint.
VIBIX_API_BASE_URL=https://api.vibix.org/api/v1
#
# Устаревшие имена переменных — читаются как fallback, если VIBIX_*
# не заданы. Существующий .env продолжает работать без правок:
# VIDEO_SERVICE_PUBLISHER_ID, VIDEO_SERVICE_API_KEY.
# Оформление внешнего плеера: дизайн (1-6) и цвета для дизайнов 1 и 6.
# Пустые цвета убирают data-colorN из тега.
VIDEO_SERVICE_DESIGN=1
VIDEO_SERVICE_COLOR1=#ff8a1f
VIDEO_SERVICE_COLOR2=#ffffff
VIDEO_SERVICE_COLOR3=#ffb057
VIDEO_SERVICE_COLOR4=#e06d00
VIDEO_SERVICE_COLOR5=#0b0b0c
# Автовоспроизведение внешнего плеера (data-autoplay). Браузеры часто
# блокируют запуск со звуком без действия зрителя — включайте осознанно.
VIDEO_SERVICE_AUTOPLAY=False
# Трейлер для kp/imdb-эмбедов (data-trailer): "true" — трейлер, когда
# полного видео в каталоге сервиса нет; "only" — всегда только трейлер;
# пустое значение отключает параметр.
VIDEO_SERVICE_TRAILER=
# Отдельная рекламная сеть. Оставляйте выключенной без отдельного consent,
# privacy/legal/security review: её loader выполняет fingerprinting и может
# загружать сторонние VAST/VPAID-креативы. Форматы задаются ниже.
ADS_NETWORK_ENABLED=False
ADS_NETWORK_PUBLISHER_ID=678503345
ADS_NETWORK_ADD_TYPES=sticker,pcsticker,banners


# ─── Только для docker compose ───────────────────────────────────────
# Пароль базы внутри compose. Должен совпадать с паролем в DATABASE_URL.
POSTGRES_DB=lumibox
POSTGRES_USER=lumibox
POSTGRES_PASSWORD=