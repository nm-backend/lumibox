# ──────────────────────────────────────────────────────────────────────
# Пример переменных окружения LumiBox.
#
# Быстрый старт:
#   cp .env.example .env          # скопируйте
#   ./start.sh                    # поднимет всё одной командой
# или вручную:
#   podman-compose up --build -d  # / docker compose up --build -d
#
# Сам .env в git НЕ попадает (.gitignore).
# Этот файл — шаблон с комментариями, НЕ заполняйте его напрямую.
# ──────────────────────────────────────────────────────────────────────


# ─── Обязательное (без этих проект не стартует) ──────────────────────

# config.settings.development — локально, config.settings.production — в бою.
DJANGO_SETTINGS_MODULE=config.settings.development

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Через запятую, без протокола: lumibox.com,www.lumibox.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://пользователь:пароль@хост:порт/база
# Локально (Docker/Podman): postgres://lumibox:ПАРОЛЬ@localhost:5433/lumibox
DATABASE_URL=

# Отладка. В бою всегда пусто или False.
DJANGO_DEBUG=True


# ─── Кэш и фоновые задачи ────────────────────────────────────────────

# redis://хост:порт/0
# Пусто — кэш живёт в памяти процесса, а задачи выполняются прямо
# в запросе. Сайт поднимется, но без общего кэша между воркерами.
# В Docker/Podman: redis://localhost:6380/0
REDIS_URL=


# ─── Сеть ────────────────────────────────────────────────────────────

# Сколько доверенных прокси перед приложением.
# 0 — прокси нет. За Nginx/Caddy ставьте 1.
DJANGO_NUM_PROXIES=0


# ─── Администратор ───────────────────────────────────────────────────

# Создаётся автоматически entrypoint.sh при первом `up`.
# Сгенерировать пароль: python -c "import secrets; print(secrets.token_urlsafe(18))"
DJANGO_SUPERUSER_EMAIL=admin@lumibox.local
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=


# ─── Хранилище медиа: Cloudflare R2 или любое S3-совместимое ──────────

# Пока не заполнено, файлы лежат на диске контейнера и пропадают при его
# пересоздании. Для боя с настоящим видео хранилище обязательно.
#
# Включается наличием имени бакета: если оно задано, остальные переменные
# этой группы становятся обязательными.
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT_URL=
# Для R2 всегда auto; для S3 — регион бакета.
CLOUDFLARE_R2_REGION_NAME=auto
# Публичный адрес раздачи: домен R2.dev, свой поддомен или CDN перед ним.
CLOUDFLARE_R2_PUBLIC_URL=


# ─── Почта ───────────────────────────────────────────────────────────

# Пока EMAIL_HOST пуст, письма печатаются в лог (console backend).
# Сброс пароля не будет работать без реального SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LumiBox <noreply@lumibox.app>
SERVER_EMAIL=root@lumibox.app
# Принудительно оставить печать писем в лог даже при настроенном SMTP.
EMAIL_BACKEND=


# ─── Необязательное ──────────────────────────────────────────────────

# Отслеживание ошибок. Пусто — Sentry не подключается.
SENTRY_DSN=

# Идентификатор Google Analytics. Пусто — трекинга нет.
GA_MEASUREMENT_ID=


# ─── Внешний видеосервис Vibix (плеер и синхронизация) ────────────────

# Плеер встраивается на страницы записей тегом <ins> по ID видео.
# publisher_id выдаёт кабинет сервиса и привязывает к разрешённому домену.
VIBIX_PUBLISHER_ID=
# Токен доступа к API сервиса (Authorization: Bearer).
VIBIX_API_TOKEN=
# Production API. Менять только если Vibix выдал другой endpoint.
VIBIX_API_BASE_URL=https://api.vibix.org/api/v1

# Оформление внешнего плеера: дизайн (1-6) и цвета для дизайнов 1 и 6.
VIDEO_SERVICE_DESIGN=1
VIDEO_SERVICE_COLOR1=#ff8a1f
VIDEO_SERVICE_COLOR2=#ffffff
VIDEO_SERVICE_COLOR3=#ffb057
VIDEO_SERVICE_COLOR4=#e06d00
VIDEO_SERVICE_COLOR5=#0b0b0c
# Автовоспроизведение (data-autoplay). Браузеры блокируют со звуком.
VIDEO_SERVICE_AUTOPLAY=False
# Трейлер: "true" — когда видео нет, "only" — всегда трейлер.
VIDEO_SERVICE_TRAILER=true

# Рекламная сеть. Оставляйте выключенной без privacy/legal review.
ADS_NETWORK_ENABLED=False
ADS_NETWORK_PUBLISHER_ID=678503345
ADS_NETWORK_ADD_TYPES=sticker,pcsticker,banners


# ─── Только для docker / podman compose ──────────────────────────────
# Пароль базы внутри compose. Должен совпадать с паролем в DATABASE_URL.
POSTGRES_DB=lumibox
POSTGRES_USER=lumibox
POSTGRES_PASSWORD=
