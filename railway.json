{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/app/scripts/run_web.sh",
    "healthcheckPath": "/healthz/",
    "healthcheckTimeout": 100,
    "env": {
      "CLOUDFLARE_R2_ACCESS_KEY_ID": null,
      "CLOUDFLARE_R2_SECRET_ACCESS_KEY": null,
      "CLOUDFLARE_R2_BUCKET_NAME": null,
      "CLOUDFLARE_R2_ENDPOINT_URL": null,
      "CLOUDFLARE_R2_REGION_NAME": "auto",
      "CLOUDFLARE_R2_PUBLIC_URL": null,
      "VIBIX_PUBLISHER_ID": null,
      "VIBIX_API_TOKEN": null,
      "VIBIX_API_BASE_URL": "https://api.vibix.org/api/v1",
      "VIDEO_SERVICE_TRAILER": "true"
    },
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
