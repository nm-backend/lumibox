{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c \"python manage.py migrate --noinput && python manage.py ensure_demo_data && python manage.py seed_videos && gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 3 --timeout 60\"",
    "healthcheckPath": "/healthz/",
    "healthcheckTimeout": 100,
    "env": {
      "AWS_ACCESS_KEY_ID": null,
      "AWS_SECRET_ACCESS_KEY": null,
      "AWS_STORAGE_BUCKET_NAME": null,
      "AWS_S3_ENDPOINT_URL": null,
      "AWS_S3_REGION_NAME": "auto",
      "CLOUDFLARE_R2_PUBLIC_URL": null
    },
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
