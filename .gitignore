# Настройки и секреты
.env

# Виртуальное окружение
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Django
*.log
db.sqlite3
staticfiles/

# Freebuff desktop runtime files
.freebuff/*.db*

# Загруженные пользователями файлы: в репозитории им не место,
# но сама папка нужна — поэтому храним только .gitkeep внутри неё.
media/*
!media/.gitkeep

# Редакторы
.vscode/
.idea/
*.swp

# Операционная система
.DS_Store
Thumbs.db
.coverage

# Freebuff worktrees (embedded git repos)
.freebuff/worktrees/
